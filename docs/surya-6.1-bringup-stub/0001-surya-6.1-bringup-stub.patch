From b6b665560ed3ee1b06ac75ab5cb09a968c036e60 Mon Sep 17 00:00:00 2001
From: arena-ai <arena-ai@users.noreply.github.com>
Date: Thu, 26 Nov 2026 01:37:20 +0000
Subject: [PATCH] arm64: dts/vendor: add initial surya (POCO X3 NFC) bring-up
 stub

Add a minimal, non-bootable bring-up starting point for Xiaomi surya
(sm6150/sdmmagpie, POCO X3 NFC / J20C) on the 6.1 seventeen tree.

- Add surya-sm6150.dts vendor DT stub with board-id/msm-id from the 4.14
  sdmmagpie-idp-overlay-miui overlay (msm-id 365 0x0, board-id 34 0).
- Wire surya-sm6150.dtb into vendor/qcom Makefile.
- Add vendor/surya.config fragment with sm6150 base options and TODOs.
- Add MACH_XIAOMI_SURYA Kconfig entry.

TODO: memory map validation, display (NT36672C), touch (NT36xxx SPI),
haptics (AW8624/DRV2624), battery auth (onewire_gpio + DS28E16),
audio, camera, modem/IPA, sensors, MIUI compatibility.
---
 arch/arm64/Kconfig.platforms                  |  6 ++
 arch/arm64/boot/dts/vendor/qcom/Makefile      |  1 +
 .../boot/dts/vendor/qcom/surya-sm6150.dts     | 74 +++++++++++++++++++
 arch/arm64/configs/vendor/surya.config        | 62 ++++++++++++++++
 4 files changed, 143 insertions(+)
 create mode 100644 arch/arm64/boot/dts/vendor/qcom/surya-sm6150.dts
 create mode 100644 arch/arm64/configs/vendor/surya.config

diff --git a/arch/arm64/Kconfig.platforms b/arch/arm64/Kconfig.platforms
index 68dff067b..8881dbc92 100644
--- a/arch/arm64/Kconfig.platforms
+++ b/arch/arm64/Kconfig.platforms
@@ -255,6 +255,12 @@ config MACH_XIAOMI_VIOLET
 	  camera UAPI its CamX blobs expect (cam_cmd_probe carries a sensor
 	  name).
 
+config MACH_XIAOMI_SURYA
+	bool "Xiaomi surya (POCO X3 NFC / J20C)"
+	help
+	  Build for the Xiaomi surya/karna (sm6150/sdmmagpie).
+	  Initial bring-up stub - not bootable yet.
+
 config MACH_XIAOMI_SWEET
 	bool "Xiaomi sweet (Redmi Note 10 Pro)"
 	help
diff --git a/arch/arm64/boot/dts/vendor/qcom/Makefile b/arch/arm64/boot/dts/vendor/qcom/Makefile
index 9ea90cefd..411d38998 100644
--- a/arch/arm64/boot/dts/vendor/qcom/Makefile
+++ b/arch/arm64/boot/dts/vendor/qcom/Makefile
@@ -1,5 +1,6 @@
 # SPDX-License-Identifier: GPL-2.0
 dtb-$(CONFIG_ARCH_QCOM) += violet-sm6150.dtb
+dtb-$(CONFIG_ARCH_QCOM) += surya-sm6150.dtb
 
 # The violet ABL hangs before the kernel on a DTB of 381,880 bytes or more
 # (4.14's 630 KB one passes; the mechanism is unknown). A full __symbols__
diff --git a/arch/arm64/boot/dts/vendor/qcom/surya-sm6150.dts b/arch/arm64/boot/dts/vendor/qcom/surya-sm6150.dts
new file mode 100644
index 000000000..6805a9350
--- /dev/null
+++ b/arch/arm64/boot/dts/vendor/qcom/surya-sm6150.dts
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Surya (POCO X3 NFC / J20C, sm6150/sdmmagpie) - initial 6.1 bring-up stub.
+ *
+ * Ported/audited from msm-4.14 tree:
+ *   - arch/arm64/boot/dts/qcom/sdmmagpie-idp-overlay-miui.dts
+ *   - arch/arm64/boot/dts/qcom/haptic.dtsi
+ *   - arch/arm64/boot/dts/qcom/touchscreen.dtsi
+ *
+ * STATUS: STUB - not bootable. Needs memory map, display, touch, haptics,
+ * audio, camera, modem, battery auth, and MIUI userspace compatibility work.
+ */
+/dts-v1/;
+
+#include <dt-bindings/input/linux-event-codes.h>
+#include "sm6150.dtsi"
+
+/ {
+	model = "Xiaomi POCO X3 NFC";
+	compatible = "xiaomi,surya", "qcom,sm6150";
+	/* Values from 4.14 sdmmagpie-idp-overlay-miui.dts */
+	qcom,msm-id = <365 0x0>;
+	qcom,board-id = <34 0>;
+};
+
+/*
+ * TODO(surya): Verify memory layout on 6.1/sm6150 base.
+ * 4.14 used sdmmagpie-idp.dtsi memory regions; do not copy sm6150.dtsi
+ * SA6155 defaults blindly. Validate against actual surya firmware/ABL.
+ */
+
+/* TODO(surya): Add reserved memory / ramoops layout once verified. */
+
+/* Secure-world GPIOs; keep reserved ranges as on other sm6150 devices. */
+&tlmm {
+	gpio-reserved-ranges = <0 4>;
+};
+
+/*
+ * TODO(surya): ADSP/PIL - confirm firmware paths and late-boot policy.
+ * &adsp_pas { status = "okay"; };
+ */
+
+/*
+ * TODO(surya): Display - 4.14 used NT36672C Huaxing/Tianma FHD video panels
+ * (dsi_nt36672c_huaxing_fhd_video_display, dsi_nt36672c_tianma_fhd_video_display).
+ * Port panel nodes to 6.1 DRM/MSM DSI bindings.
+ */
+
+/*
+ * TODO(surya): Touchscreen - Novatek NT36xxx SPI (novatek,NVT-ts-spi).
+ * 4.14: qupv3_se0_spi, reset gpio8, irq gpio9, spi-max-frequency 19200000.
+ * Driver: drivers/input/touchscreen/nt36xxx_spi/ (needs 6.1 API port).
+ */
+
+/*
+ * TODO(surya): Haptics - AW8624/DRV2624 on qupv3_se1_i2c @0x5A.
+ * 4.14: awinic,aw8624_haptic / ti,drv2624, reset gpio63, irq gpio26.
+ * Drivers: drivers/misc/aw8624_haptic/, drivers/misc/drv2624_haptic/.
+ */
+
+/*
+ * TODO(surya): Battery auth - xiaomi,onewire_gpio (gpio6) + maxim,ds28e16.
+ * Drivers: drivers/power/supply/maxim/onewire_gpio.c, ds28e16.c.
+ */
+
+/*
+ * TODO(surya): Audio - port violet/sm6150 audio overlay patterns to surya
+ * speaker/codec routing.
+ */
+
+/*
+ * TODO(surya): Camera, NFC, sensors, IR SPI, charger/fuel gauge, USB.
+ */
diff --git a/arch/arm64/configs/vendor/surya.config b/arch/arm64/configs/vendor/surya.config
new file mode 100644
index 000000000..bbdf893ce
--- /dev/null
+++ b/arch/arm64/configs/vendor/surya.config
@@ -0,0 +1,62 @@
+# surya (POCO X3 NFC / J20C, SM6150/sdmmagpie) - initial 6.1 bring-up stub.
+# Based on violet.config structure; trimmed and marked with TODOs.
+# STATUS: STUB - not validated for boot or MIUI userspace.
+CONFIG_LOCALVERSION="-surya"
+
+# Boot/debug (adjust as bring-up progresses)
+CONFIG_CMDLINE="earlycon=msm_geni_serial,0xa90000 console=ttyMSM0,115200n8 androidboot.hardware=qcom androidboot.console=ttyMSM0"
+CONFIG_CMDLINE_EXTEND=y
+CONFIG_PSTORE=y
+CONFIG_PSTORE_CONSOLE=y
+CONFIG_PSTORE_PMSG=y
+CONFIG_PSTORE_RAM=y
+
+# SoC / platform
+CONFIG_ARCH_QCOM=y
+CONFIG_ARCH_SA6155=y
+CONFIG_PINCTRL_SM6150=y
+CONFIG_SM_GCC_6150=y
+CONFIG_SM_GPUCC_6150=y
+CONFIG_SM_DISPCC_6150=y
+CONFIG_SM_VIDEOCC_6150=y
+CONFIG_INTERCONNECT_QCOM_SM6150=y
+
+# Core QCOM (review against sm6150 6.1 vendor requirements)
+CONFIG_QCOM_RPMH=y
+CONFIG_QCOM_RPMHPD=y
+CONFIG_QCOM_COMMAND_DB=y
+CONFIG_QCOM_AOSS_QMP=y
+CONFIG_QCOM_SMEM=y
+CONFIG_QCOM_SMP2P=y
+CONFIG_QCOM_GLINK=y
+CONFIG_QCOM_GLINK_SMEM=y
+CONFIG_RPMSG_QCOM_GLINK=y
+CONFIG_RPMSG_QCOM_GLINK_SMEM=y
+CONFIG_QCOM_Q6V5_COMMON=y
+CONFIG_QCOM_Q6V5_PAS=y
+CONFIG_QCOM_PIL_INFO=y
+CONFIG_QCOM_RPROC_COMMON=y
+CONFIG_QCOM_SYSMON=y
+CONFIG_QCOM_SCM=y
+CONFIG_QCOM_SOCINFO=y
+
+# Device identity
+CONFIG_MACH_XIAOMI_SURYA=y
+
+# TODO(surya): Touch - NT36xxx SPI (novatek,NVT-ts-spi)
+# 4.14 driver: drivers/input/touchscreen/nt36xxx_spi/
+# Port driver to 6.1 or use an upstream-compatible alternative.
+# CONFIG_TOUCHSCREEN_NT36XXX_SPI is not set
+
+# TODO(surya): Haptics - AW8624 / DRV2624
+# 4.14 drivers: drivers/misc/aw8624_haptic/, drivers/misc/drv2624_haptic/
+# CONFIG_INPUT_AW8624_HAPTIC is not set
+# CONFIG_INPUT_DRV2624_HAPTIC is not set
+
+# TODO(surya): Battery auth - onewire_gpio + maxim ds28e16
+# 4.14 drivers: drivers/power/supply/maxim/
+# CONFIG_ONEWIRE_GPIO_XIAOMI is not set
+# CONFIG_BATT_VERIFY_DS28E16 is not set
+
+# TODO(surya): Display panels (NT36672C Huaxing/Tianma), audio, camera,
+# Wi-Fi/BT, modem/IPA, NFC, sensors, IR, charger/fuel gauge.
-- 
2.39.5

