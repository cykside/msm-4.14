# surya (POCO X3 NFC / J20C, SM6150/sdmmagpie) - initial 6.1 bring-up stub.
# Based on violet.config structure; trimmed and marked with TODOs.
# STATUS: STUB - not validated for boot or MIUI userspace.
CONFIG_LOCALVERSION="-surya"

# Boot/debug (adjust as bring-up progresses)
CONFIG_CMDLINE="earlycon=msm_geni_serial,0xa90000 console=ttyMSM0,115200n8 androidboot.hardware=qcom androidboot.console=ttyMSM0"
CONFIG_CMDLINE_EXTEND=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# SoC / platform
CONFIG_ARCH_QCOM=y
CONFIG_ARCH_SA6155=y
CONFIG_PINCTRL_SM6150=y
CONFIG_SM_GCC_6150=y
CONFIG_SM_GPUCC_6150=y
CONFIG_SM_DISPCC_6150=y
CONFIG_SM_VIDEOCC_6150=y
CONFIG_INTERCONNECT_QCOM_SM6150=y

# Core QCOM (review against sm6150 6.1 vendor requirements)
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_GLINK=y
CONFIG_QCOM_GLINK_SMEM=y
CONFIG_RPMSG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_PIL_INFO=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_SOCINFO=y

# Device identity
CONFIG_MACH_XIAOMI_SURYA=y

# TODO(surya): Touch - NT36xxx SPI (novatek,NVT-ts-spi)
# 4.14 driver: drivers/input/touchscreen/nt36xxx_spi/
# Port driver to 6.1 or use an upstream-compatible alternative.
# CONFIG_TOUCHSCREEN_NT36XXX_SPI is not set

